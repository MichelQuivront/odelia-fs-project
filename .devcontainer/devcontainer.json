{
  "name": "Kanban full-stack (Jakarta EE + Angular)",

  // Reuse the project's compose file and add a "dev" service on top of it.
  "dockerComposeFile": [
    "../docker-compose.yml",
    "docker-compose.yml"
  ],
  "service": "dev",
  "workspaceFolder": "/workspace/odelia-fs-project",

  // The database and Keycloak come up with the dev container; the
  // backend and the frontend are still run by hand (mvn liberty:dev / npm start).
  "runServices": ["postgres", "keycloak"],

  "features": {
    "ghcr.io/devcontainers/features/java:1.8.3": {
      "version": "21",
      "jdkDistro": "tem",
      "installMaven": true,
      "mavenVersion": "latest"
    },
    "ghcr.io/devcontainers/features/node:2.1.0": {
      "version": "22"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  // 9080 = Liberty (mvn liberty:dev), 4200 = ng serve, 5432 = PostgreSQL,
  // 8081 = Keycloak (the browser is redirected there, so it must be forwarded)
  "forwardPorts": [9080, 4200, 5432, 8081],
  "portsAttributes": {
    "9080": { "label": "backend (Liberty)" },
    "4200": { "label": "frontend (Angular)" },
    "5432": { "label": "postgres" },
    "8081": { "label": "keycloak" }
  },

  // mvn liberty:dev reads DB_HOST (see backend/.../server.xml); inside the
  // compose network the database is reachable as "postgres".
  "containerEnv": {
    "DB_HOST": "postgres"
  },

  // Angular's `ng test` runs headless Chrome (via the puppeteer devDependency,
  // which downloads its own Chromium via its postinstall hook on `npm install`);
  // these apt packages are the shared libraries that Chromium needs to actually
  // launch. The download can silently fail to run in sandboxed build
  // environments that allow the npm registry but block the Chrome-for-Testing
  // CDN, so it's repeated explicitly (`npx puppeteer browsers install chrome`)
  // to fail the postCreateCommand loudly instead of surfacing later as a
  // confusing "Cannot start ChromeHeadless" error from `npm test`.
  //
  // The plain-http Ubuntu mirror URIs are switched to https first: in some
  // networks (observed in this devcontainer's sandbox), large debs like
  // mesa-libgallium/libllvm20 (pulled in by libgbm1) hang and fail over
  // plain http while the identical https download succeeds, which used to
  // abort this whole postCreateCommand chain before `npm install` ever ran.
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.m2 && sudo sed -i 's#http://\\(archive\\|security\\)\\.ubuntu\\.com/#https://\\1.ubuntu.com/#' /etc/apt/sources.list.d/ubuntu.sources && sudo apt-get update -qq && sudo apt-get install -y --no-install-recommends ca-certificates fonts-liberation libasound2t64 libatk-bridge2.0-0t64 libatk1.0-0t64 libatspi2.0-0t64 libcairo2 libcups2t64 libdbus-1-3 libdrm2 libexpat1 libgbm1 libglib2.0-0t64 libgtk-3-0t64 libnspr4 libnss3 libpango-1.0-0 libpangocairo-1.0-0 libx11-6 libx11-xcb1 libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 libxkbcommon0 libxrandr2 xdg-utils && cd frontend && npm install && if [ $(uname -m) = aarch64 ]; then npx playwright-core install chromium; else npx puppeteer browsers install chrome; fi",

  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.java",
        "vscjava.vscode-java-debug",
        "vscjava.vscode-maven",
        "Open-Liberty.liberty-dev-vscode-ext",
        "Angular.ng-template",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
